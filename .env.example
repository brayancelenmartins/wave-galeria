# Copie este arquivo para ".env.local" e preencha para ligar o Supabase.
# Sem estas variáveis o site roda em modo demonstração (dados só no navegador, /admin sem login).

# Supabase > Settings > API (Project URL)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase > Settings > API Keys: chave "publishable" (sb_publishable_...) ou a antiga "anon"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
